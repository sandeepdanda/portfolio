---
import "../styles/global.css";
import { SITE, NAV } from "../config";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import frauncesWoff2 from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import interWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Single-page home enables the scroll-spy tab nav. Detail pages set false. */
  singlePage?: boolean;
}

const { title, description, ogImage, singlePage = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const pageDescription = description ?? SITE.description;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const currentPath = Astro.url.pathname;

const OG_SLUGS = new Set([
  "home",
  "about",
  "experience",
  "education",
  "projects",
  "404",
  "projects/not-another-rewatch",
  "projects/readloot",
  "projects/wellness-pro",
  "projects/fake-news-detection",
  "projects/reinforcement-learning",
]);

function deriveOgSlug(pathname: string): string {
  const trimmed = pathname.replace(/^\/|\/$/g, "");
  if (trimmed === "") return "home";
  return OG_SLUGS.has(trimmed) ? trimmed : "home";
}

const ogUrl = new URL(ogImage ?? `/og/${deriveOgSlug(currentPath)}.png`, SITE.url).toString();

// Anchor targets for the single-page nav. "/" -> "#me", "/education" -> "#education".
// On the single page these smooth-scroll; on detail routes "/#anchor" navigates home.
function navHref(href: string): string {
  const anchor = href === "/" ? "me" : href.replace(/^\//, "");
  return singlePage ? `#${anchor}` : `/#${anchor}`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- OG -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />

    <!-- Fonts self-hosted via @fontsource-variable (imported in global.css). Preload critical weights. -->
    <link rel="preload" href={frauncesWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />

    <!-- Theme script: run before paint to avoid flash -->
    <script is:inline>
      const stored = localStorage.getItem("theme");
      if (stored) {
        document.documentElement.dataset.theme = stored;
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <!-- Signature: vertical rule down the left edge -->
    <div class="vertical-rule" aria-hidden="true"></div>

    <header class="site-header">
      <nav class="nav" aria-label="Primary">
        <a href="/" class="brand">{SITE.name}</a>
        <ul class="nav-list">
          {NAV.map((item) => (
            <li>
              <a
                href={navHref(item.href)}
                class="nav-link"
                data-nav-anchor={singlePage ? navHref(item.href) : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          {singlePage && <span class="nav-indicator" aria-hidden="true"></span>}
        </ul>
      </nav>
    </header>

    <main id="main" class="main">
      <slot />
    </main>

    <Footer />
    <ThemeToggle />

    {singlePage && (
      <script is:inline>
        // Scroll-spy with a single underline that SLIDES to the active tab.
        (() => {
          const list = document.querySelector('.nav-list');
          const indicator = document.querySelector('.nav-indicator');
          const links = Array.from(
            document.querySelectorAll('.nav-link[data-nav-anchor]')
          );
          if (!list || !indicator || links.length === 0) return;

          const map = new Map();
          for (const a of links) {
            const anchor = a.getAttribute('data-nav-anchor');
            if (!anchor) continue;
            const sec = document.querySelector(anchor);
            if (sec) map.set(sec, a);
          }
          if (map.size === 0) return;

          let activeLink = links[0];

          // Move the bar under a given link, measured against the nav-list box.
          function moveTo(link) {
            if (!link) return;
            const l = link.getBoundingClientRect();
            const base = list.getBoundingClientRect();
            indicator.style.width = l.width + 'px';
            indicator.style.transform = 'translateX(' + (l.left - base.left) + 'px)';
            indicator.style.opacity = '1';
          }

          function setCurrent(link) {
            activeLink = link;
            for (const a of links) {
              if (a === link) a.setAttribute('aria-current', 'page');
              else a.removeAttribute('aria-current');
            }
            moveTo(link);
          }

          const io = new IntersectionObserver(
            (entries) => {
              let best = null;
              let bestRatio = 0;
              for (const e of entries) {
                if (e.isIntersecting && e.intersectionRatio > bestRatio) {
                  bestRatio = e.intersectionRatio;
                  best = e.target;
                }
              }
              if (best && map.has(best)) setCurrent(map.get(best));
            },
            { rootMargin: '-45% 0px -45% 0px', threshold: [0, 0.25, 0.5, 1] }
          );
          for (const sec of map.keys()) io.observe(sec);

          // Hover preview: slide to the hovered tab, snap back to active on leave.
          links.forEach((a) => {
            a.addEventListener('mouseenter', () => moveTo(a));
          });
          list.addEventListener('mouseleave', () => moveTo(activeLink));

          // Recompute on resize / font load so the bar stays aligned.
          const recompute = () => moveTo(activeLink);
          if ('ResizeObserver' in window) {
            new ResizeObserver(recompute).observe(list);
          } else {
            window.addEventListener('resize', recompute);
          }
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(recompute);
          }

          // Initial placement under the first tab.
          setCurrent(links[0]);
        })();
      </script>
    )}

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        padding: 0.5rem 1rem;
        background: var(--color-accent);
        color: var(--color-bg);
        z-index: 100;
        font-weight: 500;
        border-radius: 0 0 4px 0;
      }
      .skip-link:focus {
        left: 0;
        top: 0;
      }

      /* Signature rule hugs the LEFT edge of the centered content column.
         Column is 56rem wide and centered, so its left edge sits at
         calc(50% - 28rem); clamp so it never goes off-screen on narrow views. */
      .vertical-rule {
        position: fixed;
        left: max(1rem, calc(50% - 28rem));
        top: 0;
        bottom: 0;
        width: 1px;
        background: var(--color-border);
        pointer-events: none;
        z-index: 0;
      }

      .site-header {
        display: flex;
        align-items: center;
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--color-border);
        position: sticky;
        top: 0;
        z-index: 20;
        background: color-mix(in srgb, var(--color-bg) 88%, transparent);
        backdrop-filter: blur(10px);
      }
      @media (max-width: 768px) {
        .site-header {
          padding: 1rem;
        }
      }

      /* Nav shares the centered 56rem measure so brand + tabs line up with
         the content column edges below. */
      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        max-width: 56rem;
        margin: 0 auto;
        gap: 2rem;
      }

      .brand {
        font-family: var(--font-serif);
        font-size: 1.5rem;
        font-weight: 500;
        color: var(--color-text);
        letter-spacing: -0.01em;
      }

      .nav-list {
        position: relative;
        display: flex;
        gap: 1.75rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      @media (max-width: 768px) {
        .nav-list {
          gap: 1rem;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
        }
        .nav-list::-webkit-scrollbar { display: none; }
      }

      .nav-link {
        font-family: var(--font-serif);
        font-size: 1.0625rem;
        font-weight: 400;
        color: var(--color-text-muted);
        position: relative;
        padding: 0.25rem 0;
        white-space: nowrap;
        transition: color 150ms ease-out;
      }
      .nav-link:hover {
        color: var(--color-text);
      }
      .nav-link[aria-current="page"] {
        color: var(--color-text);
      }

      /* Single underline that slides between tabs. Positioned by JS via
         transform + width; only those animate, so it stays GPU-cheap. */
      .nav-indicator {
        position: absolute;
        left: 0;
        bottom: -0.25rem;
        height: 2px;
        width: 0;
        background: var(--color-accent);
        opacity: 0;
        transform: translateX(0);
        transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1),
                    width 280ms cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 200ms ease-out;
        pointer-events: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .nav-indicator { transition-duration: 0.01ms; }
      }

      .main {
        padding: 2.5rem 2rem 3rem 2rem;
        max-width: 56rem;
        margin: 0 auto;
        position: relative;
        z-index: 1;
      }
      @media (max-width: 768px) {
        .main {
          padding: 1.5rem 1rem 3rem 2rem;
        }
      }
    </style>
  </body>
</html>
