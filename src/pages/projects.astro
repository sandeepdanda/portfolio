---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Projects"
  description="Things I have shipped or maintain."
>
  <section class="hero">
    <h1>Things I <em>build</em></h1>
    <p class="subtitle">I start a project to learn one new thing. I finish it after learning five others I did not plan for.</p>
  </section>

  <ul class="cards">
    {projects.map((entry) => (
      <li>
        <Card
          href={`/projects/${entry.id}`}
          label="Project"
          headline={entry.data.name}
          tags={entry.data.tags}
        >
          <p slot="body" class="summary">{entry.data.summary}</p>
        </Card>
      </li>
    ))}
  </ul>
</Base>

<style>
  .hero { margin: 0 0 4rem 0; }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: 0;
  }
  h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent);
  }
  .subtitle {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 34rem;
    margin: 1.25rem 0 0 0;
  }

  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 52rem;
    display: grid;
    gap: 1rem;
  }
  .cards li { display: flex; }
  .summary {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 36rem;
    margin: 0;
  }
</style>
