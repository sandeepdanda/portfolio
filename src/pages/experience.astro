---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import BrandMark from "../components/BrandMark.astro";

const jobs = [
  {
    role: "Software Development Engineer",
    company: "Amazon",
    brand: "amazon" as const,
    url: "https://aws.amazon.com/",
    years: "Apr 2025 – present",
    location: "Seattle, WA",
    tags: ["Java", "TypeScript", "React", "AWS CDK", "CloudWatch"],
  },
  {
    role: "Business Technology Analyst",
    company: "Deloitte",
    brand: "deloitte" as const,
    url: "https://www2.deloitte.com/",
    years: "Jun 2021 – Dec 2022",
    location: "Hyderabad, India",
    tags: ["Salesforce", "Apex", "SOQL", "Lightning", "Admin"],
  },
  {
    role: "Assistant Software Engineer",
    company: "Nucleus Software",
    brand: "nucleus" as const,
    url: "https://www.nucleussoftware.com/",
    years: "Aug 2020 – Jun 2021",
    location: "Noida, India",
    tags: ["Java", "Spring Boot", "Oracle"],
  },
];
---

<Base
  title="Experience"
  description="Where I have worked so far."
>
  <section class="hero">
    <h1>Where I <em>worked</em></h1>
    <p class="subtitle">Every job so far has convinced me that the people around me know what they are doing. It is still hard to believe I am one of them.</p>
  </section>

  <ul class="cards">
    {jobs.map((j) => (
      <li>
        <Card
          href={j.url}
          label={j.role}
          headline={j.company}
          tags={j.tags}
        >
          <Fragment slot="meta">
            <span>{j.years}</span>
            <span aria-hidden="true">·</span>
            <span>{j.location}</span>
          </Fragment>
          <BrandMark company={j.brand} slot="body" />
        </Card>
      </li>
    ))}
  </ul>
</Base>

<style>
  .hero { margin: 0 0 4rem 0; }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: 0;
  }
  h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent);
  }
  .subtitle {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 34rem;
    margin: 1.25rem 0 0 0;
  }

  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 52rem;
    display: grid;
    gap: 1rem;
  }
  .cards li { display: flex; }
</style>
