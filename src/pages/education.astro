---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";

const entries = [
  {
    degree: "MS, Computer Science",
    school: "University at Buffalo, SUNY",
    url: "https://www.buffalo.edu/",
    years: "Jan 2023 – Dec 2024",
    location: "Buffalo, NY",
    gpa: "3.80 / 4.00",
  },
  {
    degree: "BTech, Information Technology",
    school: "NIT Durgapur",
    url: "https://nitdgp.ac.in/",
    years: "2016 – 2020",
    location: "Durgapur, India",
    gpa: "7.8 / 10.0",
  },
  {
    degree: "High School (Class 12)",
    school: "Narayana Junior College",
    url: "https://www.narayanajuniorcolleges.com/",
    years: "2014 – 2016",
    location: "Hyderabad, India",
    gpa: "985 / 1000",
  },
  {
    degree: "High School (Class 10)",
    school: "Aryabhatta Concept School",
    url: "https://aryabhattaschools.org/",
    years: "2014",
    location: "Thorrur, India",
    gpa: "10.0 / 10.0",
  },
];
---

<Base
  title="Education"
  description="Where I studied."
>
  <section class="hero">
    <h1>Where I <em>studied</em></h1>
    <p class="subtitle">From a small town school in Thorrur, to grad school in Buffalo, with a lot of homesickness stitched in between.</p>
  </section>

  <ul class="cards">
    {entries.map((e) => (
      <li>
        <Card
          href={e.url}
          label={e.degree}
          headline={e.school}
        >
          <Fragment slot="meta">
            <span>{e.years}</span>
            <span aria-hidden="true">·</span>
            <span>{e.location}</span>
            {e.gpa && <><span aria-hidden="true">·</span><span>GPA {e.gpa}</span></>}
          </Fragment>
        </Card>
      </li>
    ))}
  </ul>
</Base>

<style>
  .hero { margin: 0 0 4rem 0; }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: 0;
  }
  h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent);
  }
  .subtitle {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 34rem;
    margin: 1.25rem 0 0 0;
  }

  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 52rem;
    display: grid;
    gap: 1rem;
  }
  .cards li { display: flex; }
</style>
