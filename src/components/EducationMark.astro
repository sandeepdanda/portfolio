---
// Hover micro-mark for education cards, drawn inline. Mirrors BrandMark:
// one small motif per school, animated on the parent .card hover, degrades to a
// meaningful static state under prefers-reduced-motion.
//   - buffalo   : snowflakes drift down the card, tinted UB Blue (#005bbb).
//                 Snow is a deliberate winter metaphor; UB Blue is the brand color.
//   - nit       : NIT Durgapur's emblem is a cog/gear seal with a red lamp-flame
//                 inside. Mark = a gear ring that turns + a red flame that ignites.
//   - narayana/aryabhatta: no glyph here — they use the .card--underline sweep
//     defined in Card.astro (the headline itself underlines L->R on hover)
//
// Usage (inside a Card body slot):
//   <EducationMark school="buffalo" slot="body" />
interface Props {
  school: "buffalo" | "nit" | "narayana" | "aryabhatta";
}
const { school } = Astro.props;
---

<span class="edu-mark" data-school={school} aria-hidden="true">
  {school === "buffalo" && (
    <span class="em-snow">
      {[0, 1, 2, 3, 4, 5].map((i) => (
        <svg class="em-flake" width="10" height="10" viewBox="0 0 9 9" fill="none" style={`--i:${i}`}>
          <path d="M4.5 0.5V8.5M0.5 4.5H8.5M1.7 1.7L7.3 7.3M7.3 1.7L1.7 7.3"
            stroke="#005bbb" stroke-width="0.8" stroke-linecap="round" />
        </svg>
      ))}
    </span>
  )}

  {school === "nit" && (
    <span class="em-seal">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
        {/* gear ring — engineering institute seal, drop the lettering */}
        <circle class="em-cog" cx="8" cy="8" r="6.2" fill="none"
          stroke="var(--color-text-muted)" stroke-width="1.3" stroke-dasharray="1.7 1.7" />
        {/* lamp base + red flame (NIT Durgapur's lamp of knowledge) */}
        <path d="M6.1 12 H9.9 L9 13.3 H7 Z" fill="var(--color-text-muted)" />
        <path class="em-flame" d="M8 11.3 C6.4 9.9 7.1 8 8 6.7 C8.9 8 9.6 9.9 8 11.3 Z" fill="#e8261c" />
      </svg>
    </span>
  )}
</span>

<style>
  .edu-mark {
    display: inline-flex;
    align-items: center;
    min-height: 16px;
  }

  /* ---- Buffalo: UB-Blue snowflakes drift down the whole card on hover ---- */
  .em-snow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    border-radius: 6px;
  }
  .em-flake { position: absolute; top: -10px; opacity: 0; }
  .em-flake:nth-child(1) { left: 14%; }
  .em-flake:nth-child(2) { left: 30%; }
  .em-flake:nth-child(3) { left: 46%; }
  .em-flake:nth-child(4) { left: 62%; }
  .em-flake:nth-child(5) { left: 78%; }
  .em-flake:nth-child(6) { left: 90%; }

  /* ---- NIT Durgapur: gear-seal + red lamp-flame (from the real emblem) ---- */
  .em-seal { display: inline-flex; }
  .em-cog { transform-box: fill-box; transform-origin: center; }
  .em-flame {
    transform-box: fill-box;
    transform-origin: bottom center;
    transform: scaleY(0.35);
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.card:hover) .em-flake,
    :global(.card:focus-visible) .em-flake {
      animation: em-drift 1.5s ease-in infinite;
      animation-delay: calc(var(--i) * 160ms);
    }
    @keyframes em-drift {
      0% { transform: translateY(0) rotate(0); opacity: 0; }
      15% { opacity: 0.85; }
      100% { transform: translateY(160px) rotate(180deg); opacity: 0; }
    }

    .em-cog { transition: transform 600ms ease; }
    .em-flame { transition: transform 280ms ease-out, opacity 200ms ease; }
    :global(.card:hover) .em-cog,
    :global(.card:focus-visible) .em-cog { transform: rotate(30deg); }
    :global(.card:hover) .em-flame,
    :global(.card:focus-visible) .em-flame {
      opacity: 1;
      animation: em-ignite 260ms ease-out forwards, em-flicker 600ms steps(3, end) 260ms infinite;
    }
    @keyframes em-ignite {
      from { transform: scaleY(0.35); }
      to { transform: scaleY(1); }
    }
    @keyframes em-flicker {
      0% { transform: scaleY(1); }
      50% { transform: scaleY(1.1); }
      100% { transform: scaleY(0.97); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .em-flame { transform: scaleY(1); opacity: 1; }
  }
</style>
