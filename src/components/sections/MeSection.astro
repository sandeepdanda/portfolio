---
// Hero / intro section. Top of the single-page scroll.
import { SOCIAL } from "../../config";
---

<section class="hero" id="me" aria-label="Introduction">
  <h1>Sandeep <em>Danda</em></h1>
  <p class="location">
    <a href="https://www.google.com/maps/place/Seattle,+WA" target="_blank" rel="noopener noreferrer">
      <svg class="pin" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 0 1 16 0z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
      Seattle
    </a>
    · Software Development Engineer
  </p>
  <p class="tagline">
    Three years of writing quiet code in loud rooms. I build backend
    systems at Amazon - the service that does not page at 3am, the
    migration that ships on a Thursday and nobody notices. Curious
    about AI tooling, hiking trails, and the thirty seconds before a
    deploy.
  </p>
  <p class="cue">
    <a href="/#education" class="scroll-cue">
      Scroll, or press <kbd>⌘</kbd><kbd>K</kbd> to jump anywhere
      <span class="arrow" aria-hidden="true">↓</span>
    </a>
  </p>
</section>

<style>
  .hero {
    margin: 0 0 6rem 0;
    scroll-margin-top: 6rem;
  }
  .location {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin: 1.25rem 0 1.75rem 0;
  }
  .location a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1px;
    transition: color 150ms ease-out, border-color 150ms ease-out;
  }
  .location a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  .pin {
    flex-shrink: 0;
    max-width: 12px;
    max-height: 12px;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 9vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: 0;
  }
  h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent);
  }
  .tagline {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.45;
    color: var(--color-text);
    max-width: 36rem;
    margin: 0;
    font-weight: 400;
  }

  .cue {
    margin: 2.5rem 0 0 0;
  }
  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .scroll-cue:hover {
    color: var(--color-accent);
  }
  .scroll-cue kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    color: var(--color-text);
    background: var(--color-surface);
  }
  .arrow {
    display: inline-block;
    transition: transform 200ms ease-out;
  }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue:hover .arrow {
      transform: translateY(3px);
    }
  }
</style>
