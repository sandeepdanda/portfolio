---
import SectionHeader from "./SectionHeader.astro";
import { SOCIAL } from "../../config";
---

<section class="section" id="about" aria-label="About">
  <SectionHeader
    number="04"
    title="Nice to"
    em="meet you"
    subtitle="The parts a resume leaves out."
  />

  <div class="bio">
    <p>
      I write backends - the quiet, reliable kind. What I like is the
      shape of the thing: idempotent writes, replay queues, alarms that
      fire for the right reason. Less glamorous than it sounds, more
      interesting than it looks.
    </p>
    <p>
      I started in Thorrur, a small town in Telangana, wrote Java for a
      bank in Delhi, did Salesforce work at Deloitte, then a masters at
      Buffalo before Seattle. Lately I keep getting pulled into AI tooling -
      agents, MCPs, and making a team's tools do more than they were built for.
    </p>
  </div>

  <dl class="facts">
    <div>
      <dt>Now</dt>
      <dd>Seattle · backend SDE at Amazon</dd>
    </div>
    <div>
      <dt>Stack</dt>
      <dd>Java · TypeScript · Python · AWS</dd>
    </div>
    <div>
      <dt>Off the clock</dt>
      <dd>cooking · badminton · PNW trails</dd>
    </div>
    <div>
      <dt>Curious about</dt>
      <dd>agents · MCPs · developer tooling</dd>
    </div>
  </dl>

  <div class="links-section">
    <p class="kicker">Say hi</p>
    <div class="connect-row">
      <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" class="connect-icon" aria-label="GitHub" data-tip="GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.63 0-12 5.37-12 12 0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.21.09 1.85 1.24 1.85 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.94 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.4 1.02 0 2.05.14 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.62-2.81 5.63-5.48 5.93.43.37.82 1.1.82 2.22 0 1.61-.02 2.9-.02 3.3 0 .32.22.69.83.57C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="connect-icon" aria-label="LinkedIn" data-tip="LinkedIn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.44-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.37 4.28 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
        </svg>
      </a>

      <span class="connect-divider" aria-hidden="true"></span>

      <a href={SOCIAL.email} class="connect-icon" aria-label="Email me" data-tip="Email me">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-10 5L2 7"/>
        </svg>
      </a>
      <button class="connect-icon copy" type="button" data-copy="sandeepdanda.dev@gmail.com" aria-label="Copy email address" data-tip="Copy email">
        <svg class="copy-icon copy-icon--copy" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        <svg class="copy-icon copy-icon--check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span class="sr-only copy-label">Copy</span>
      </button>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".copy");
  buttons.forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const value = btn.dataset.copy ?? "";
      const label = btn.querySelector<HTMLElement>(".copy-label");
      try {
        await navigator.clipboard.writeText(value);
        btn.classList.add("copied");
        btn.setAttribute("data-tip", "Copied");
        if (label) label.textContent = "Copied";
      } catch {
        btn.setAttribute("data-tip", "Press ⌘C");
      }
      setTimeout(() => {
        btn.classList.remove("copied");
        btn.setAttribute("data-tip", "Copy email");
        if (label) label.textContent = "Copy";
      }, 1600);
    });
  });
</script>

<style>
  .section {
    position: relative;
    margin-bottom: 0;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 44rem;
  }
  .bio p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0;
  }

  /* Quick facts strip - spans the same 52rem column as the section cards
     above so the right edge lines up. 4 across on desktop, wraps down small. */
  .facts {
    margin: 1.75rem 0 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
    max-width: 52rem;
  }
  @media (max-width: 720px) {
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 460px) {
    .facts { grid-template-columns: 1fr; }
  }
  .facts div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-left: 1px solid var(--color-border);
    padding-left: 0.75rem;
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-accent);
  }
  .facts dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .links-section {
    max-width: 52rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .links-section .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin: 0 0 1rem 0;
  }

  /* Compact icon row - GitHub, LinkedIn, then email + copy after a divider. */
  .connect-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .connect-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 150ms ease-out, border-color 150ms ease-out, transform 150ms ease-out;
  }
  .connect-icon:hover,
  .connect-icon:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .connect-icon:hover { transform: translateY(-2px); }
  }

  .connect-divider {
    width: 1px;
    height: 1.5rem;
    background: var(--color-border);
    margin: 0 0.25rem;
    flex-shrink: 0;
  }

  /* Tooltip from data-tip, above the icon. */
  .connect-icon::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease-out, transform 150ms ease-out;
  }
  .connect-icon:hover::after,
  .connect-icon:focus-visible::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Copy button: swap copy glyph for a check when .copied. */
  .copy .copy-icon--check { display: none; }
  .copy.copied {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .copy.copied .copy-icon--copy { display: none; }
  .copy.copied .copy-icon--check { display: block; }
</style>
