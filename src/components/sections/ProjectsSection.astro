---
import { getCollection } from "astro:content";
import Card from "../Card.astro";
import SectionHeader from "./SectionHeader.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section class="section" id="projects" aria-label="Projects">
  <SectionHeader
    number="03"
    title="Things I"
    em="build"
    subtitle="I start every project to learn one thing, and finish it having accidentally learned five."
  />

  <ul class="cards">
    {projects.map((entry) => (
      <li>
        <Card
          href={`/projects/${entry.id}`}
          label="Project"
          headline={entry.data.name}
          tags={entry.data.tags}
          density="compact"
        >
          <p slot="body" class="summary">{entry.data.summary}</p>
        </Card>
      </li>
    ))}
  </ul>
</section>

<style>
  .section {
    position: relative;
    margin-bottom: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 52rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  /* One column on narrow screens. */
  @media (max-width: 600px) {
    .cards { grid-template-columns: 1fr; }
  }
  .cards li { display: flex; }
  .summary {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
