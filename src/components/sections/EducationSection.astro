---
import Card from "../Card.astro";
import EducationMark from "../EducationMark.astro";
import SectionHeader from "./SectionHeader.astro";

const entries = [
  {
    degree: "MS, Computer Science",
    school: "University at Buffalo, SUNY",
    mark: "buffalo" as const,
    url: "https://www.buffalo.edu/",
    years: "Jan 2023 – Dec 2024",
    location: "Buffalo, NY",
    gpa: "3.80 / 4.00",
  },
  {
    degree: "BTech, Information Technology",
    school: "NIT Durgapur",
    mark: "nit" as const,
    url: "https://nitdgp.ac.in/",
    years: "2016 – 2020",
    location: "Durgapur, India",
    gpa: "7.8 / 10.0",
  },
  {
    degree: "High School (Class 12)",
    school: "Narayana Junior College",
    mark: "narayana" as const,
    url: "https://www.narayanajuniorcolleges.com/",
    years: "2014 – 2016",
    location: "Hyderabad, India",
    gpa: "985 / 1000",
  },
  {
    degree: "High School (Class 10)",
    school: "Aryabhatta Concept School",
    mark: "aryabhatta" as const,
    url: "https://aryabhattaschools.org/",
    years: "2014",
    location: "Thorrur, India",
    gpa: "10.0 / 10.0",
  },
];
---

<section class="section" id="education" aria-label="Education">
  <SectionHeader
    number="01"
    title="Where I"
    em="studied"
    subtitle="A boarding school at ten, a grad school at twenty-five, and a whole lot of homesick phone calls in between."
  />

  <ul class="cards">
    {entries.map((e) => (
      <li>
        <Card
          href={e.url}
          label={e.degree}
          headline={e.school}
          density="compact"
          class={e.mark === "narayana" || e.mark === "aryabhatta" ? "card--underline" : undefined}
        >
          <Fragment slot="meta">
            <span>{e.years}</span>
            <span aria-hidden="true">·</span>
            <span>{e.location}</span>
            {e.gpa && <><span aria-hidden="true">·</span><span>GPA {e.gpa}</span></>}
          </Fragment>
          <EducationMark school={e.mark} slot="mark" />
        </Card>
      </li>
    ))}
  </ul>
</section>

<style>
  .section {
    position: relative;
    margin-bottom: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 52rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .cards li {
    display: flex;
    min-width: 0;
  }
  @media (max-width: 600px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
