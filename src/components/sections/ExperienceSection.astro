---
import Card from "../Card.astro";
import BrandMark from "../BrandMark.astro";
import SectionHeader from "./SectionHeader.astro";

const jobs = [
  {
    role: "Software Development Engineer",
    company: "Amazon",
    brand: "amazon" as const,
    url: "https://aws.amazon.com/",
    years: "Apr 2025 – present",
    location: "Seattle, WA",
    tags: ["Java", "TypeScript", "React", "AWS CDK", "CloudWatch"],
  },
  {
    role: "Business Technology Analyst",
    company: "Deloitte",
    brand: "deloitte" as const,
    url: "https://www2.deloitte.com/",
    years: "Jun 2021 – Dec 2022",
    location: "Hyderabad, India",
    tags: ["Salesforce", "Apex", "SOQL", "Lightning", "Admin"],
  },
  {
    role: "Assistant Software Engineer",
    company: "Nucleus Software",
    brand: "nucleus" as const,
    url: "https://www.nucleussoftware.com/",
    years: "Aug 2020 – Jun 2021",
    location: "Noida, India",
    tags: ["Java", "Spring Boot", "Oracle"],
  },
];
---

<section class="section" id="experience" aria-label="Experience">
  <SectionHeader
    number="01"
    title="Where I"
    em="worked"
    subtitle="Three roles across financial software, enterprise platforms, and cloud services."
  />

  <ul class="cards">
    {jobs.map((j) => (
      <li>
        <Card
          href={j.url}
          label={j.role}
          headline={j.company}
          tags={j.tags}
        >
          <Fragment slot="meta">
            <span>{j.years}</span>
            <span aria-hidden="true">·</span>
            <span>{j.location}</span>
          </Fragment>
          <BrandMark company={j.brand} slot="mark" />
        </Card>
      </li>
    ))}
  </ul>
</section>
