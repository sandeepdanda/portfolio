---
import Card from "../Card.astro";
import BrandMark from "../BrandMark.astro";
import SectionHeader from "./SectionHeader.astro";

const jobs = [
  {
    role: "Software Development Engineer",
    company: "Amazon",
    brand: "amazon" as const,
    url: "https://aws.amazon.com/",
    years: "Apr 2025 – present",
    location: "Seattle, WA",
    tags: ["Java", "TypeScript", "React", "AWS CDK", "CloudWatch"],
  },
  {
    role: "Business Technology Analyst",
    company: "Deloitte",
    brand: "deloitte" as const,
    url: "https://www2.deloitte.com/",
    years: "Jun 2021 – Dec 2022",
    location: "Hyderabad, India",
    tags: ["Salesforce", "Apex", "SOQL", "Lightning", "Admin"],
  },
  {
    role: "Assistant Software Engineer",
    company: "Nucleus Software",
    brand: "nucleus" as const,
    url: "https://www.nucleussoftware.com/",
    years: "Aug 2020 – Jun 2021",
    location: "Noida, India",
    tags: ["Java", "Spring Boot", "Oracle"],
  },
];
---

<section class="section" id="experience" aria-label="Experience">
  <SectionHeader
    number="02"
    title="Where I"
    em="worked"
    subtitle="Every job so far has convinced me that the people around me know what they are doing. It is still hard to believe I am one of them."
  />

  <ul class="cards">
    {jobs.map((j) => (
      <li>
        <Card
          href={j.url}
          label={j.role}
          headline={j.company}
          tags={j.tags}
        >
          <Fragment slot="meta">
            <span>{j.years}</span>
            <span aria-hidden="true">·</span>
            <span>{j.location}</span>
          </Fragment>
          <BrandMark company={j.brand} slot="mark" />
        </Card>
      </li>
    ))}
  </ul>
</section>

<style>
  .section {
    position: relative;
    margin-bottom: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 52rem;
    display: grid;
    gap: 0.75rem;
  }
  .cards li { display: flex; }
</style>
