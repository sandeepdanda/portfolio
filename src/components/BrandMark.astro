---
// Brand-true hover micro-mark, drawn inline (no external assets, no scraping).
// Each company gets one small motif that animates on the parent .card hover and
// degrades gracefully under prefers-reduced-motion (final state shown, never blank).
//
// Design rule (from the motion research): a sub-20px motif only reads if the
// animation CHANGES THE SILHOUETTE or reveals withheld information. So:
//   - Amazon  : stroke-dashoffset "draw" of the smile arrow (nothing -> a mark)
//   - Deloitte: the dot MORPHS round -> square and slides to "punctuate" the name
//               (form change, not a sub-threshold size pulse)
//   - Nucleus : a center dot with an orbiting ring that DRAWS via dashoffset
//               (atom/nucleus metaphor; not a symmetric rotation no-op)
//
// Usage (inside a Card body slot):
//   <BrandMark company="amazon" slot="body" />
interface Props {
  company: "amazon" | "deloitte" | "nucleus";
}
const { company } = Astro.props;
---

<span class="brand-mark" data-company={company} aria-hidden="true">
  {company === "amazon" && (
    <svg class="bm-amazon" width="60" height="18" viewBox="0 0 60 18" fill="none">
      {/* shallow smile arc + arrow tip, Amazon orange */}
      <path
        class="bm-amazon-arc"
        d="M3 5 C 18 16, 44 16, 57 5"
        stroke="#FF9900"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        class="bm-amazon-tip"
        d="M51 3 L57 5 L54 11"
        stroke="#FF9900"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    </svg>
  )}

  {company === "deloitte" && (
    <span class="bm-deloitte"><i class="bm-dot"></i><span class="bm-trail"></span></span>
  )}

  {company === "nucleus" && (
    <svg class="bm-nucleus" width="22" height="22" viewBox="0 0 22 22" fill="none">
      <circle class="bm-orbit" cx="11" cy="11" r="8" stroke="var(--color-accent)" stroke-width="1.4" />
      <circle class="bm-core" cx="11" cy="11" r="2.4" fill="var(--color-accent)" />
    </svg>
  )}
</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    height: 22px;
  }

  /* ---- Amazon: smile arrow draws on hover ---- */
  .bm-amazon-arc,
  .bm-amazon-tip {
    stroke-dasharray: 90;
    stroke-dashoffset: 90;
  }

  /* ---- Deloitte: green dot that morphs round->square and slides ---- */
  .bm-deloitte {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .bm-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #86bc25; /* Deloitte green */
    flex-shrink: 0;
  }
  /* a short green rule that draws out from the dot — "punctuation" gesture */
  .bm-trail {
    width: 0;
    height: 2px;
    background: #86bc25;
    border-radius: 2px;
  }

  /* ---- Nucleus: orbiting ring draws around a core ---- */
  .bm-orbit {
    stroke-dasharray: 52;
    stroke-dashoffset: 52;
    transform-origin: 11px 11px;
  }
  .bm-core { transform-origin: 11px 11px; transform: scale(0.6); opacity: 0.5; }

  @media (prefers-reduced-motion: no-preference) {
    .bm-amazon-arc,
    .bm-amazon-tip { transition: stroke-dashoffset 520ms ease-out; }
    :global(.card:hover) .bm-amazon-arc,
    :global(.card:focus-visible) .bm-amazon-arc { stroke-dashoffset: 0; }
    :global(.card:hover) .bm-amazon-tip,
    :global(.card:focus-visible) .bm-amazon-tip { stroke-dashoffset: 0; transition-delay: 320ms; }

    .bm-dot { transition: border-radius 260ms ease; }
    .bm-trail { transition: width 360ms ease 120ms; }
    :global(.card:hover) .bm-dot,
    :global(.card:focus-visible) .bm-dot { border-radius: 1px; }
    :global(.card:hover) .bm-trail,
    :global(.card:focus-visible) .bm-trail { width: 22px; }

    .bm-orbit { transition: stroke-dashoffset 700ms ease-out; }
    .bm-core { transition: transform 360ms ease 200ms, opacity 360ms ease 200ms; }
    :global(.card:hover) .bm-orbit,
    :global(.card:focus-visible) .bm-orbit { stroke-dashoffset: 0; }
    :global(.card:hover) .bm-core,
    :global(.card:focus-visible) .bm-core { transform: scale(1); opacity: 1; }
  }

  /* Reduced motion: show the final, meaningful state instantly (never blank). */
  @media (prefers-reduced-motion: reduce) {
    .bm-amazon-arc,
    .bm-amazon-tip { stroke-dashoffset: 0; }
    .bm-dot { border-radius: 1px; }
    .bm-trail { width: 22px; }
    .bm-orbit { stroke-dashoffset: 0; }
    .bm-core { transform: scale(1); opacity: 1; }
  }
</style>
