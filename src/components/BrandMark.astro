---
// Brand-true hover micro-mark, drawn inline (no external assets, no scraping).
// Each company gets one small motif that animates on the parent .card hover and
// degrades gracefully under prefers-reduced-motion (final state shown, never blank).
//
// Each motif is BRAND-TRUE to the org and animates by changing silhouette /
// drawing on (a sub-20px symmetric tween reads as a no-op):
//   - Amazon  : the a->z smile arrow draws via stroke-dashoffset (the logo)
//   - Deloitte: the green "full stop" — Deloitte's actual brand element ("Deloitte.")
//               — lands by scaling in with a slight slide (nothing -> the dot)
//   - Nucleus : the real Nucleus Software icon is a solid core wrapped in
//               concentric rings (#0653c7). Rings ripple outward from the core.
//
// Usage (inside a Card body slot):
//   <BrandMark company="amazon" slot="body" />
interface Props {
  company: "amazon" | "deloitte" | "nucleus";
}
const { company } = Astro.props;
---

<span class="brand-mark" data-company={company} aria-hidden="true">
  {company === "amazon" && (
    <svg class="bm-amazon" width="60" height="18" viewBox="0 0 60 18" fill="none">
      {/* shallow smile arc + arrow tip, Amazon orange */}
      <path
        class="bm-amazon-arc"
        d="M3 5 C 18 16, 44 16, 57 5"
        stroke="#FF9900"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        class="bm-amazon-tip"
        d="M51 3 L57 5 L54 11"
        stroke="#FF9900"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    </svg>
  )}

  {company === "deloitte" && (
    <svg class="bm-deloitte" width="16" height="16" viewBox="0 0 16 16" fill="none">
      <circle class="bm-fullstop" cx="8" cy="11" r="3" fill="#86BC25" />
    </svg>
  )}

  {company === "nucleus" && (
    <svg class="bm-nucleus" width="20" height="20" viewBox="0 0 16 16" fill="none">
      <circle class="bm-core" cx="8" cy="8" r="1.7" fill="#0653c7" />
      <circle class="bm-ring" cx="8" cy="8" r="4" stroke="#0653c7" stroke-width="1.2" />
      <circle class="bm-ring" cx="8" cy="8" r="6.6" stroke="#0653c7" stroke-width="1.2" />
    </svg>
  )}
</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    height: 16px;
  }

  /* ---- Amazon: smile arrow draws on hover ---- */
  .bm-amazon-arc,
  .bm-amazon-tip {
    stroke-dasharray: 90;
    stroke-dashoffset: 90;
  }

  /* ---- Deloitte: the green "full stop" lands (Deloitte's brand element) ---- */
  .bm-fullstop {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0) translateX(5px);
    opacity: 0;
  }

  /* ---- Nucleus: solid core, concentric rings ripple outward ---- */
  .bm-ring {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.2);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bm-amazon-arc,
    .bm-amazon-tip { transition: stroke-dashoffset 520ms ease-out; }
    :global(.card:hover) .bm-amazon-arc,
    :global(.card:focus-visible) .bm-amazon-arc { stroke-dashoffset: 0; }
    :global(.card:hover) .bm-amazon-tip,
    :global(.card:focus-visible) .bm-amazon-tip { stroke-dashoffset: 0; transition-delay: 320ms; }

    .bm-fullstop { transition: transform 280ms cubic-bezier(.34,1.56,.64,1), opacity 180ms ease; }
    :global(.card:hover) .bm-fullstop,
    :global(.card:focus-visible) .bm-fullstop { transform: scale(1) translateX(0); opacity: 1; }

    .bm-ring { transition: transform 320ms ease, opacity 320ms ease; }
    :global(.card:hover) .bm-ring,
    :global(.card:focus-visible) .bm-ring { transform: scale(1); opacity: 1; }
    :global(.card:hover) .bm-ring:nth-of-type(3),
    :global(.card:focus-visible) .bm-ring:nth-of-type(3) { transition-delay: 90ms; }
  }

  /* Reduced motion: show the final, meaningful state instantly (never blank). */
  @media (prefers-reduced-motion: reduce) {
    .bm-amazon-arc,
    .bm-amazon-tip { stroke-dashoffset: 0; }
    .bm-fullstop { transform: scale(1); opacity: 1; }
    .bm-ring { transform: scale(1); opacity: 1; }
  }
</style>
